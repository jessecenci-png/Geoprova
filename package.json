{
  "name": "geoprova",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "vite build",
    "preview": "node --use-env-proxy node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "test": "node --test --test-isolation=none",
    "bundle": "node scripts/standalone.mjs",
    "start": "node --use-env-proxy server.mjs",
    "check:publication": "node scripts/validate-publication.mjs"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "vite": "6.4.1"
  }
}
